# Frontend Environment Variables
# Copy to .env.local and fill in values. See docs/reference/env-and-secrets.md.

# ============================================================================
# FIREBASE (required for auth)
# ============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ============================================================================
# BACKEND
# ============================================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Voice local/dev path requires direct backend transport (no proxy fallback).
# Keep NEXT_PUBLIC_BACKEND_URL pointed at the backend host for realtime voice.
# Optional explicit override (also enforced by default in development):
# NEXT_PUBLIC_VOICE_DIRECT_BACKEND=true
# Optional but recommended for native passkey RP inference when
# NEXT_PUBLIC_PASSKEY_RP_ID is not explicitly set.
# NEXT_PUBLIC_APP_URL=https://your-frontend-domain.example
# NEXT_PUBLIC_FRONTEND_URL=https://your-frontend-domain.example

# ============================================================================
# PASSKEY / DOMAIN ASSOCIATION
# ============================================================================
# Optional explicit RP ID for passkeys.
# - Web: leave unset to use host-based RP ID.
# - Native iOS/Android: set explicitly if you use a custom domain.
# - Keep unset if you want localhost + hosted dual-domain enrollment.
# NEXT_PUBLIC_PASSKEY_RP_ID=your-frontend-domain.example

# iOS associated app identifier = <APPLE_TEAM_ID>.<NEXT_PUBLIC_IOS_BUNDLE_ID>
NEXT_PUBLIC_IOS_BUNDLE_ID=com.hushh.app
# APPLE_TEAM_ID=ABCDE12345
# NEXT_PUBLIC_APPLE_TEAM_ID=ABCDE12345

# Android Digital Asset Links
NEXT_PUBLIC_ANDROID_APP_ID=com.hushh.app
# Comma-separated SHA-256 cert fingerprints for signing certs
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...:ZZ,11:22:...

# ============================================================================
# BUILD / RUNTIME
# ============================================================================
# CAPACITOR_BUILD is set by npm run cap:build
NEXT_PUBLIC_ENVIRONMENT_MODE=development
# NODE_ENV is set by Next.js

# ============================================================================
# OPTIONAL (server-side only; do not prefix with NEXT_PUBLIC_)
# ============================================================================
# SESSION_SECRET=     # If using session API
# BACKEND_URL=        # Server-side fallback
# NEXT_PUBLIC_CONSENT_TIMEOUT_SECONDS=120
# NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ============================================================================
# APP REVIEW MODE
# ============================================================================
# App review config is now served by backend runtime endpoint:
# GET /api/app-config/review-mode

# ============================================================================
# KAI VOICE
# ============================================================================
# Local/dev realtime voice architecture (active path)
# Force direct backend transport for voice endpoints.
# NEXT_PUBLIC_VOICE_DIRECT_BACKEND=true
# Optional override to force proxy in non-realtime/non-fail-fast scenarios only.
# In development or fail-fast voice modes, proxy transport is rejected.
# NEXT_PUBLIC_VOICE_FORCE_PROXY=true
# Force realtime mic + realtime TTS active path in browser voice agent.
# NEXT_PUBLIC_FORCE_REALTIME_VOICE=true
# Voice V2 unified architecture rollout flags.
# NEXT_PUBLIC_VOICE_V2_ENABLED=true
# NEXT_PUBLIC_VOICE_V2_AUTOTURN_ENABLED=true
# Keep submit only for temporary debugging during rollout.
# NEXT_PUBLIC_VOICE_V2_SUBMIT_DEBUG_VISIBLE=false
# Client-side endpoint fallback (disabled by default; enable only if server VAD is noisy).
# NEXT_PUBLIC_VOICE_V2_CLIENT_VAD_FALLBACK_ENABLED=false
# Optional backend TTS fallback (disabled by default; realtime stream is authoritative path).
# NEXT_PUBLIC_VOICE_V2_TTS_BACKEND_FALLBACK_ENABLED=false
# Legacy compatibility only: enable stop-and-upload batch STT path.
# Disabled by default; keep off for realtime architecture validation.
# Ignored in local development where realtime path is enforced.
# NEXT_PUBLIC_ENABLE_LEGACY_BATCH_STT=true
# Legacy compatibility only: allow browser local speech synthesis when backend auth/voice path is unavailable.
# Disabled by default to keep realtime/fail-fast behavior honest during debugging.
# NEXT_PUBLIC_ENABLE_LEGACY_LOCAL_TTS_COMPAT=true
# Explicit TTS voice selection (forwarded to backend /voice/tts).
NEXT_PUBLIC_KAI_VOICE_TTS_VOICE=alloy
# Optional realtime/batch TTS timeout (milliseconds).
# NEXT_PUBLIC_KAI_VOICE_TTS_TIMEOUT_MS=20000
# Fail-fast debugging mode: disable browser TTS fallback + transport fallback.
# NEXT_PUBLIC_DISABLE_VOICE_FALLBACKS=true
# NEXT_PUBLIC_FAIL_FAST_VOICE=true
