# consent-protocol/.env.example
# Copy to .env and replace placeholder values.

# Server port (optional if not running web server)
PORT=3000

# HMAC signing key (64-character hex, 256-bit)
SECRET_KEY=replace_with_64_char_hex_secret_key

# Vault AES encryption key (64-character hex, 256-bit)
VAULT_ENCRYPTION_KEY=replace_with_64_char_hex_vault_encryption_key

# Expiration durations (milliseconds)
DEFAULT_CONSENT_TOKEN_EXPIRY_MS=604800000
DEFAULT_TRUST_LINK_EXPIRY_MS=2592000000

# App context
ENVIRONMENT=development
AGENT_ID=agent_hushh_local
HUSHH_HACKATHON=enabled
APP_REVIEW_MODE=false
# REVIEWER_EMAIL=
# REVIEWER_PASSWORD=

FRONTEND_URL=http://localhost:3000

# Vault write client version gate
MIN_VAULT_WRITE_CLIENT_VERSION=2.0.0
ENFORCE_VAULT_WRITE_CLIENT_VERSION=true

# Comma-separated passkey RP IDs allowed by backend validation.
# Include localhost for dev and all production domains during dual-domain migration.
PASSKEY_ALLOWED_RP_IDS=localhost,127.0.0.1,hushh-webapp-1006304528804.us-central1.run.app

# Supabase Session Pooler Connection
DB_USER=postgres.your_project_ref
DB_PASSWORD=replace_with_db_password
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# Google Generative AI / Vertex AI
GOOGLE_API_KEY=replace_with_google_api_key
GOOGLE_GENAI_USE_VERTEXAI=True

# MCP Developer Token (for testing without Firebase)
MCP_DEVELOPER_TOKEN=replace_with_mcp_developer_token

# Kai finance-root migration / reset test context (local only)
KAI_TEST_USER_ID=replace_with_test_user_id
KAI_TEST_PASSPHRASE=replace_with_test_passphrase
KAI_TEST_BROKERAGE_PDF_PATH=data/brokerage_statements/Brokerage_March2021.pdf
KAI_TEST_ONBOARDING_INVESTMENT_HORIZON=short_term
KAI_TEST_ONBOARDING_DRAWDOWN_RESPONSE=reduce
KAI_TEST_ONBOARDING_VOLATILITY_PREFERENCE=small

FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"replace","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"replace","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40your-project.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

FINNHUB_API_KEY=replace_with_finnhub_api_key

PMP_API_KEY=replace_with_pmp_api_key

# OpenAI Voice (Kai Level-3 conversational voice)
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_VOICE_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE_INTENT_MODEL=gpt-4.1-nano
OPENAI_VOICE_TTS_MODEL=gpt-4o-tts
OPENAI_VOICE_TTS_DEFAULT_VOICE=alloy
OPENAI_VOICE_TTS_FORMAT=mp3
OPENAI_VOICE_TTS_PREFER_QUALITY=true
# Realtime session endpoint enablement (required for browser realtime voice path)
# KAI_VOICE_REALTIME_ENABLED=true
# Realtime session defaults (server VAD, 800ms silence, autonomous response disabled) are enforced by backend route.
# Browser can still send session.update events for compatibility, but backend is authoritative.
# Force realtime voice architecture; also disables fallback chains when enabled.
# FORCE_REALTIME_VOICE=true
# Fail-fast debugging mode (disables STT/TTS/planner model fallback chains)
# DISABLE_VOICE_FALLBACKS=true
# FAIL_FAST_VOICE=true
# Optional fallback chains (comma-separated, first available model is used)
# OPENAI_VOICE_STT_MODELS=gpt-4o-mini-transcribe,whisper-1
# OPENAI_VOICE_INTENT_MODELS=gpt-4.1-nano,gpt-4o-mini,gpt-4.1-mini
# OPENAI_VOICE_TTS_MODELS=gpt-4o-tts,gpt-4o-mini-tts
# Voice V1 rollout / safety controls
# KAI_VOICE_V1_ENABLED=true
# KAI_VOICE_V1_ALLOWED_USERS=user_123,user_456
# KAI_VOICE_V1_CANARY_PERCENT=25
# KAI_VOICE_V1_DISABLE_TOOL_EXECUTION=false
